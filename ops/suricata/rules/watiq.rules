# Watiq-specific IDS rules (Security.md §5).
#
# sid range 9000000+ is reserved for local rules and will not collide with the
# Emerging Threats Open ruleset loaded alongside these.
#
# Every rule here asserts something the architecture says is IMPOSSIBLE. That is
# what makes them high-signal: none of them can fire during normal operation, so
# any hit means an architectural assumption has been violated, not that a
# threshold was exceeded.

# --- The data tier is unreachable from outside. If these fire, the network
# --- topology has been breached — page immediately, do not triage.
alert tcp $EXTERNAL_NET any -> $HOME_NET 5432 (msg:"WATIQ CRITICAL Postgres from external"; \
  flow:to_server; classtype:policy-violation; priority:1; sid:9000001; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 6379 (msg:"WATIQ CRITICAL Redis from external"; \
  flow:to_server; classtype:policy-violation; priority:1; sid:9000002; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 9000 (msg:"WATIQ CRITICAL MinIO from external"; \
  flow:to_server; classtype:policy-violation; priority:1; sid:9000003; rev:1;)

# Egress from the data tier is impossible by design (watiq_data is
# `internal: true`). If seen, assume compromise of the container runtime.
alert ip $HOME_NET any -> $EXTERNAL_NET any (msg:"WATIQ CRITICAL Data-tier egress"; \
  flow:to_server; classtype:trojan-activity; priority:1; sid:9000010; rev:1;)

# --- Exfiltration shapes -------------------------------------------------
# 8-digit CIN sequences leaving in bulk in a response body. No legitimate
# endpoint returns 50 citizen identifiers in one response; the API paginates.
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"WATIQ Possible bulk CIN exfiltration"; \
  flow:established,to_client; file_data; \
  pcre:"/\b\d{8}\b(?:[^\d]{1,40}\b\d{8}\b){49,}/"; \
  classtype:data-loss; priority:1; sid:9000020; rev:1;)

# Tracking codes leaving in bulk. Same reasoning: the format is fixed by
# fn_requests_before_insert, so a stream of them is an export.
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"WATIQ Possible bulk tracking-code exfiltration"; \
  flow:established,to_client; file_data; \
  pcre:"/WTQ-20\d{2}-[0-9A-F]{10}(?:[\s\S]{1,60}WTQ-20\d{2}-[0-9A-F]{10}){29,}/"; \
  classtype:data-loss; priority:1; sid:9000021; rev:1;)

# Argon2 material in a response. There is no endpoint that should ever emit a
# password hash; if one does, a serializer is leaking a model field.
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"WATIQ CRITICAL Password hash in response"; \
  flow:established,to_client; file_data; content:"$argon2"; \
  classtype:data-loss; priority:1; sid:9000022; rev:1;)

# --- Reconnaissance ------------------------------------------------------
# Known scanner TLS fingerprints (JA3).
alert tls $EXTERNAL_NET any -> $HOME_NET any (msg:"WATIQ Scanner JA3"; \
  ja3.hash; content:"e7d705a3286e19ea42f587b344ee6865"; \
  classtype:attempted-recon; priority:2; sid:9000030; rev:1;)

# The API is TLS-only at the edge. A cleartext request carrying an Authorization
# header means something is bypassing nginx, or a client is misconfigured and
# has just put a bearer token on the wire.
alert http $EXTERNAL_NET any -> $HOME_NET 8000 (msg:"WATIQ Cleartext credential to API port"; \
  flow:established,to_server; http.header; content:"Authorization"; nocase; \
  classtype:policy-violation; priority:1; sid:9000031; rev:1;)

# --- Post-exploitation ---------------------------------------------------
# Outbound shell-shaped traffic from the application tier. The API never
# executes a shell (Security.md §9.2), so this is reverse-shell behaviour.
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"WATIQ Possible reverse shell from app tier"; \
  flow:established,to_server; content:"/bin/"; content:"sh"; distance:0; within:8; \
  classtype:trojan-activity; priority:1; sid:9000040; rev:1;)

# DNS tunnelling: long labels to an unfamiliar domain, the standard exfil path
# when egress TCP is restricted (which it is, by nftables).
alert dns $HOME_NET any -> any any (msg:"WATIQ Possible DNS tunnelling"; \
  dns.query; pcre:"/^[a-zA-Z0-9+\/=]{50,}\./"; \
  classtype:trojan-activity; priority:2; sid:9000041; rev:1;)
