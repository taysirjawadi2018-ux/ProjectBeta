{
  "_comment": [
    "Seccomp profile for the Watiq api and worker containers (Security.md 12.4).",
    "Applied via security_opt: seccomp:./ops/docker/seccomp-watiq.json.",
    "",
    "Default action is ERRNO, not KILL: a denied syscall returns EPERM and the",
    "Python process raises PermissionError, which is logged. SCMP_ACT_KILL would",
    "terminate the worker with no diagnostic, and a seccomp profile nobody can",
    "debug is a seccomp profile that gets removed.",
    "",
    "This is Docker's default profile minus the syscalls a Python web service",
    "never issues. Each omission below is deliberate:",
    "  ptrace, process_vm_readv/writev - process injection and cross-process",
    "      memory reads; the classic way to lift secrets out of a sibling process",
    "  mount, umount2, pivot_root, chroot, unshare, setns - container escape",
    "  init_module, finit_module, delete_module, kexec_load - kernel tampering",
    "  bpf, perf_event_open - kernel-level introspection and eBPF loading",
    "  add_key, request_key, keyctl - kernel keyring",
    "  reboot, swapon, swapoff, settimeofday, clock_settime - host state",
    "  userfaultfd - a well-known kernel-exploit primitive",
    "",
    "Verify after a deploy that nothing legitimate broke:",
    "  docker run --security-opt seccomp=ops/docker/seccomp-watiq.json watiq-api:VERSION",
    "  and watch for PermissionError in the application log."
  ],
  "defaultAction": "SCMP_ACT_ERRNO",
  "defaultErrnoRet": 1,
  "archMap": [
    {
      "architecture": "SCMP_ARCH_X86_64",
      "subArchitectures": ["SCMP_ARCH_X86", "SCMP_ARCH_X32"]
    },
    {
      "architecture": "SCMP_ARCH_AARCH64",
      "subArchitectures": ["SCMP_ARCH_ARM"]
    }
  ],
  "syscalls": [
    {
      "names": [
        "accept", "accept4", "access", "arch_prctl", "bind", "brk",
        "capget", "capset", "chdir", "chmod", "chown", "chown32",
        "clock_getres", "clock_gettime", "clock_nanosleep",
        "clone", "clone3", "close", "close_range", "connect", "copy_file_range",
        "dup", "dup2", "dup3",
        "epoll_create", "epoll_create1", "epoll_ctl", "epoll_pwait",
        "epoll_pwait2", "epoll_wait",
        "eventfd", "eventfd2", "execve", "execveat", "exit", "exit_group",
        "faccessat", "faccessat2", "fadvise64", "fallocate",
        "fchdir", "fchmod", "fchmodat", "fchown", "fchownat",
        "fcntl", "fcntl64", "fdatasync", "flock", "fork",
        "fstat", "fstat64", "fstatat64", "fstatfs", "fstatfs64", "fsync",
        "ftruncate", "ftruncate64", "futex", "futex_time64", "futex_waitv",
        "getcwd", "getdents", "getdents64",
        "getegid", "geteuid", "getgid", "getgroups", "getitimer",
        "getpeername", "getpgid", "getpgrp", "getpid", "getppid",
        "getpriority", "getrandom", "getresgid", "getresuid",
        "getrlimit", "get_robust_list", "getrusage", "getsid",
        "getsockname", "getsockopt", "gettid", "gettimeofday", "getuid",
        "ioctl", "io_destroy", "io_getevents", "io_setup", "io_submit",
        "kill", "lchown", "link", "linkat", "listen",
        "lseek", "lstat", "lstat64", "madvise", "membarrier",
        "memfd_create", "mkdir", "mkdirat", "mknod", "mknodat",
        "mlock", "mmap", "mmap2", "mprotect", "mremap", "msync",
        "munlock", "munmap", "nanosleep", "newfstatat",
        "open", "openat", "openat2", "pause",
        "pipe", "pipe2", "poll", "ppoll", "prctl", "pread64", "preadv",
        "preadv2", "prlimit64", "pselect6", "pwrite64", "pwritev", "pwritev2",
        "read", "readlink", "readlinkat", "readv",
        "recv", "recvfrom", "recvmmsg", "recvmsg",
        "rename", "renameat", "renameat2", "restart_syscall",
        "rmdir", "rseq",
        "rt_sigaction", "rt_sigpending", "rt_sigprocmask", "rt_sigqueueinfo",
        "rt_sigreturn", "rt_sigsuspend", "rt_sigtimedwait",
        "sched_getaffinity", "sched_getparam", "sched_get_priority_max",
        "sched_get_priority_min", "sched_getscheduler", "sched_yield",
        "select", "sendfile", "sendfile64", "sendmmsg", "sendmsg", "sendto",
        "setgid", "setgroups", "setitimer", "setpgid", "setpriority",
        "setregid", "setresgid", "setresuid", "setreuid", "setrlimit",
        "set_robust_list", "setsid", "setsockopt", "set_tid_address",
        "shutdown", "sigaltstack", "socket", "socketpair", "splice",
        "stat", "stat64", "statfs", "statfs64", "statx",
        "symlink", "symlinkat", "sync", "sync_file_range", "syncfs",
        "sysinfo", "tgkill", "time", "timer_create", "timer_delete",
        "timer_getoverrun", "timer_gettime", "timer_settime",
        "timerfd_create", "timerfd_gettime", "timerfd_settime",
        "times", "tkill", "truncate", "truncate64",
        "umask", "uname", "unlink", "unlinkat", "utime", "utimensat", "utimes",
        "vfork", "wait4", "waitid", "waitpid", "write", "writev"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "personality: only the sane values, to block ADDR_NO_RANDOMIZE (0x0040000) which disables ASLR and is a standard exploitation aid.",
      "names": ["personality"],
      "action": "SCMP_ACT_ALLOW",
      "args": [
        { "index": 0, "value": 0, "op": "SCMP_CMP_EQ" },
        { "index": 0, "value": 8, "op": "SCMP_CMP_EQ" },
        { "index": 0, "value": 131072, "op": "SCMP_CMP_EQ" },
        { "index": 0, "value": 131080, "op": "SCMP_CMP_EQ" },
        { "index": 0, "value": 4294967295, "op": "SCMP_CMP_EQ" }
      ]
    },
    {
      "_comment": "socket(AF_NETLINK) is how a process enumerates the host network. Denied; the app talks TCP to named services only.",
      "names": ["socket"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "args": [
        { "index": 0, "value": 16, "op": "SCMP_CMP_EQ" }
      ]
    }
  ]
}
