{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://watiq.tn/formschemas/civil.birth_certificate.json",
  "title": "civil.birth_certificate",
  "description": "Extrait de naissance. Filename must equal service_catalog.code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject_national_id", "copies"],
  "properties": {
    "subject_national_id": {
      "type": "string",
      "pattern": "^[0-9]{8}$",
      "description": "CIN of the person the certificate is about, not necessarily the requester. Mirrors chk_users_national_id_format."
    },
    "subject_full_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "birth_municipality": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "birth_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "copies": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "language": {
      "type": "string",
      "enum": ["ar", "fr"]
    },
    "purpose": {
      "type": "string",
      "maxLength": 200
    }
  }
}
