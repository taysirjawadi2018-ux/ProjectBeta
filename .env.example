# Watiq — environment keys. EVERY key, NO real values (Security.md §11).
# Real secrets mount as Docker secrets under /run/secrets (pydantic-settings
# secrets_dir) and take precedence over env vars.

# --- Runtime ---------------------------------------------------------------
ENV=dev
DEBUG=false

# --- One DSN per database role (ADR-001). Migration DSN is never here; it
# is read by alembic from the migration-user secret only. -------------------
DSN_CITIZEN=postgresql+asyncpg://watiq_app_citizen:__CHANGE_ME__@postgres:5432/watiq
DSN_STAFF=postgresql+asyncpg://watiq_app_staff:__CHANGE_ME__@postgres:5432/watiq
DSN_AUTH=postgresql+asyncpg://watiq_app_auth:__CHANGE_ME__@postgres:5432/watiq
DSN_AUDITOR=postgresql+asyncpg://watiq_app_auditor:__CHANGE_ME__@postgres:5432/watiq
DSN_ADMIN=postgresql+asyncpg://watiq_app_admin:__CHANGE_ME__@postgres:5432/watiq

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=5000

# --- Redis (cache + rate limits + idempotency + ARQ) -----------------------
REDIS_DSN=rediss://watiq_api:__CHANGE_ME__@redis:6379/0
REDIS_MAX_CONNECTIONS=50

# --- Crypto ----------------------------------------------------------------
# Ed25519 PEM keypair; rotated every 90 days with a one-TTL overlap (§11).
JWT_PRIVATE_KEY=__CHANGE_ME__
JWT_PUBLIC_KEY=__CHANGE_ME__
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# 32 random bytes, base64 — the AES-256-GCM KEK for staff.mfa_secret.
MFA_ENCRYPTION_KEY=__CHANGE_ME__

# --- Object storage (MinIO) --------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_BUCKET_DOCUMENTS=watiq-documents
S3_ACCESS_KEY=__CHANGE_ME__
S3_SECRET_KEY=__CHANGE_ME__
PRESIGNED_GET_TTL_SECONDS=300
MAX_UPLOAD_BYTES=10485760

# --- CORS (strict allow-list, never "*") ------------------------------------
CORS_ORIGINS=["https://watiq.tn"]

# --- Notification channels ----------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER_KEY=
SMS_FROM=WATIQ

# --- Payment gateway ---------------------------------------------------------
PAYMENT_GATEWAY_ENDPOINT=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_TIMEOUT_SECONDS=8
