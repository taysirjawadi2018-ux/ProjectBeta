# Watiq — environment keys. EVERY key, NO real values (Security.md §11).
# Real secrets mount as Docker secrets under /run/secrets (pydantic-settings
# secrets_dir) and take precedence over env vars.
#
# ---------------------------------------------------------------------------
# YOU DO NOT NEED THIS FILE TO RUN THE DEV STACK.
#
# `docker compose up` works on a clean checkout with no .env at all: every key
# below has a working local default baked into docker-compose.yml, pointing at
# the Postgres/Redis/MinIO that same file starts. Copy this to .env only when
# you want to CHANGE something.
#
# And note what that means in reverse: anything you set here OVERRIDES the
# compose default. A stale value in .env — a dead database host, a password
# that no longer exists — silently wins over a default that would have worked.
# When the stack breaks right after it was working, read .env first, and check
# what compose actually resolved with:
#     docker compose config | grep -E 'DSN|S3_|REDIS'
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
ENV=dev
DEBUG=false

# --- One DSN per database role (ADR-001). ----------------------------------
# The values below are the local dev stack's own defaults, spelled out so you
# can see what compose uses. Leave them commented to use those defaults.
#
# Hostnames are compose service names, so they resolve inside the network and
# NOT from your host shell. Running the app outside Docker needs published
# ports and 127.0.0.1 here instead.
#
# The migration DSN is separate on purpose: it owns the schema and must never
# serve traffic (Structure.md §6). app/db/migrations/env.py refuses to run as
# any role but watiq_migrate/postgres.
#WATIQ_MIGRATE_DSN=postgresql+asyncpg://watiq_migrate:watiq-dev-migrate@postgres:5432/watiq
#DSN_CITIZEN=postgresql+asyncpg://watiq_app_citizen:watiq-dev-citizen@postgres:5432/watiq
#DSN_STAFF=postgresql+asyncpg://watiq_app_staff:watiq-dev-staff@postgres:5432/watiq
#DSN_AUTH=postgresql+asyncpg://watiq_app_auth:watiq-dev-auth@postgres:5432/watiq
#DSN_AUDITOR=postgresql+asyncpg://watiq_app_auditor:watiq-dev-auditor@postgres:5432/watiq
#DSN_ADMIN=postgresql+asyncpg://watiq_app_admin:watiq-dev-admin@postgres:5432/watiq

# Pointing at a managed database (Supabase, RDS, ...) instead:
#   - Set all six DSNs above. app/core/db.py always connects with ssl=require,
#     which managed providers want anyway.
#   - PERCENT-ENCODE THE PASSWORD. A DSN is a URL: '@', '/', ':', '?', '#' and
#     any non-ASCII character must be escaped or the URL parses into a
#     different host than you think it does. In Python:
#         python -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=''))" 'your-password'
#   - Do NOT run roles-init: it creates LOGIN roles, which a managed provider
#     does not permit. Start the app tier only:
#         docker compose up api frontend worker

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=5000

# --- Redis (cache + rate limits + idempotency + ARQ) -----------------------
# Dev default is plaintext on the internal network. Prod uses TLS + ACL users.
#REDIS_DSN=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# --- Crypto ----------------------------------------------------------------
# Ed25519 PEM keypair; rotated every 90 days with a one-TTL overlap (§11).
# docker-compose.yml carries a throwaway dev keypair so a fresh clone boots
# with no setup. Generate your own with: make dev-keys
JWT_PRIVATE_KEY=__CHANGE_ME__
JWT_PUBLIC_KEY=__CHANGE_ME__
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# 32 random bytes, base64 — the AES-256-GCM KEK for staff.mfa_secret.
# Must decode to EXACTLY 32 bytes or the app refuses to start. Generate with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
MFA_ENCRYPTION_KEY=__CHANGE_ME__

# --- Object storage (MinIO) --------------------------------------------------
# These are the MinIO root credentials AND the app's S3 credentials — compose
# feeds the same two values to both, so overriding one moves both together.
#S3_ENDPOINT=http://minio:9000
#S3_ACCESS_KEY=watiq-dev
#S3_SECRET_KEY=watiq-dev-minio
S3_BUCKET_DOCUMENTS=watiq-documents
PRESIGNED_GET_TTL_SECONDS=300
MAX_UPLOAD_BYTES=10485760

# --- Document scanning -------------------------------------------------------
# Unset disables AV scanning. ClamAV is an opt-in compose profile because it is
# amd64-only and wants ~1.5 GB RAM:  docker compose --profile av up
#CLAMD_HOST=clamav:3310

# --- CORS (strict allow-list, never "*") ------------------------------------
CORS_ORIGINS=["https://watiq.tn"]

# --- Host port mapping (change if 8000/5000 are taken on your machine) -------
#API_PORT=8000
#FRONTEND_PORT=5000

# --- Notification channels ----------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER_KEY=
SMS_FROM=WATIQ

# --- Payment gateway ---------------------------------------------------------
PAYMENT_GATEWAY_ENDPOINT=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_TIMEOUT_SECONDS=8
